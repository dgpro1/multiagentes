# Internal HTTP gateway: one origin for the whole app. "/api/*" is routed to the
# backend and everything else to the frontend. TLS is handled by the operator's
# own reverse proxy placed in front of this service in production.
# Headers every response carries. Only the widget page (/widget/*) may be framed,
# by the customer sites that embed it; everything else refuses to sit in a frame.
(security_headers) {
	header {
		X-Content-Type-Options nosniff
		Referrer-Policy strict-origin-when-cross-origin
		Permissions-Policy "camera=(), geolocation=(), microphone=(self)"
		Strict-Transport-Security "max-age=31536000"
		-Server
	}
	@framable not path /widget/*
	header @framable Content-Security-Policy "frame-ancestors 'self'; base-uri 'self'; object-src 'none'"
}

:80 {
	import security_headers
	handle /api/* {
		reverse_proxy api:8000
	}
	handle {
		reverse_proxy web:3000
	}
}
