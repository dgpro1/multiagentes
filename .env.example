# Local PostgreSQL
DATABASE_URL=postgresql+psycopg://openlivery:openlivery@localhost:5432/openlivery

# Change these keys before using real data (at least 32 characters)
SECRET_KEY=change-this-long-random-key-in-production
ENCRYPTION_KEY=change-this-other-long-random-key

# Frontend origin allowed by CORS
FRONTEND_URL=http://localhost:3000

# Session cookie flags. Behind HTTPS set COOKIE_SECURE=true. If the frontend and
# API are on different sites, set COOKIE_SAMESITE=none (which requires
# COOKIE_SECURE=true).
COOKIE_SECURE=false
COOKIE_SAMESITE=lax


# Public backend URL used by Next.js
NEXT_PUBLIC_API_URL=http://localhost:8000

# Local WhatsApp bridge (Go, whatsmeow) — the QR driver when Evolution is not
# configured. Use the same long random token in the API and the bridge.
BACKEND_URL=http://localhost:8000
WHATSAPP_BRIDGE_URL=http://localhost:3101
WHATSAPP_BRIDGE_PORT=3101
WHATSAPP_BRIDGE_TOKEN=generate-a-long-random-token-for-the-bridge

# WhatsApp QR lines through a self-hosted Evolution API (Node, Baileys).
# With url+key set (and WHATSAPP_QR_DRIVER on "auto") it replaces the local
# bridge: docker compose brings one up at http://evolution:8080. The webhook
# URL must be reachable from the Evolution container — inside Docker that is
# the API service; on a bare-metal install use the public origin.
EVOLUTION_API_URL=http://localhost:8080
EVOLUTION_API_KEY=
EVOLUTION_WEBHOOK_SECRET=change-this-evolution-webhook-secret
EVOLUTION_WEBHOOK_URL=
# "auto" picks Evolution when url+key are set, otherwise the local bridge.
# Force one with "evolution" or "bridge".
WHATSAPP_QR_DRIVER=auto
# Session store for the bridge: a SQLite path by default, or a postgres:// URL
# (add ?search_path=whatsmeow to keep its tables in a dedicated schema).
# WHATSAPP_STORE_URL=file:whatsmeow.db

# Hours without messages after which an AI-handled conversation resolves
# itself. Conversations a person took over never close automatically. 0 disables.
# AUTO_RESOLVE_AFTER_HOURS=24

# WhatsApp Cloud API (official Meta API). Channel credentials are configured
# per client in the UI; this only overrides the Graph API root (e.g. to pin a
# version or point at a mock in tests).
# META_GRAPH_BASE_URL=https://graph.facebook.com/v23.0
# The Meta app id the channel tokens belong to. Needed only to upload the
# sample image, video or PDF of a template header.
# WHATSAPP_APP_ID=

# The model catalog is read live from OpenRouter. Transcription models are the
# one part OpenRouter does not list, so they are declared here.
# TRANSCRIPTION_MODELS=openai/gpt-4o-mini-transcribe,openai/gpt-4o-transcribe,openai/gpt-transcribe

# WhatsApp API, Instagram and Messenger through one provider key.
# The event webhook is registered automatically; it must be publicly
# reachable, so in production FRONTEND_URL is the public origin.
MESSAGING_PROVIDER_API_KEY=
MESSAGING_PROVIDER_WEBHOOK_SECRET=change-this-webhook-secret
# MESSAGING_PROVIDER_BASE_URL=https://zernio.com/api/v1
# MESSAGING_PROVIDER_PUBLIC_URL=https://app.example.com

# Instagram professional accounts and Facebook Page messaging.
# Complete docs/en/social-channels.md before enabling external accounts.
SOCIAL_PUBLIC_URL=
SOCIAL_GRAPH_VERSION=v25.0
INSTAGRAM_APP_ID=
INSTAGRAM_APP_SECRET=
INSTAGRAM_WEBHOOK_VERIFY_TOKEN=
INSTAGRAM_HUMAN_AGENT_ENABLED=false
MESSENGER_APP_ID=
MESSENGER_APP_SECRET=
MESSENGER_WEBHOOK_VERIFY_TOKEN=
MESSENGER_HUMAN_AGENT_ENABLED=false
MESSENGER_LOGIN_CONFIG_ID=
SOCIAL_WORKER_ENABLED=true
SOCIAL_WORKER_INTERVAL_SECONDS=2
